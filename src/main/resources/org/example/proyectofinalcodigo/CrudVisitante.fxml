<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" prefWidth="950" prefHeight="840"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalcodigo.viewController.VisitanteViewController"
      style="-fx-background-color: #f0f4f8;">

    <!-- Barra de cabecera -->
    <HBox spacing="12" alignment="CENTER_LEFT" prefHeight="54"
          style="-fx-background-color: #0071e3; -fx-padding: 0 18 0 18;">
        <Button text="&lt; Volver" onAction="#onVolver"
                style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Label text="Gestion de Visitantes"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblAforo" text="Aforo: 0/500"
               style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        <Button text="Ver Mapa" onAction="#onVerMapa"
                style="-fx-background-color: rgba(255,255,255,0.22); -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12px;
                       -fx-font-weight: bold;"/>
        <Label fx:id="lblNotificacion" text=""
               visible="false" managed="false"
               wrapText="true" maxWidth="280"
               style="-fx-background-color: #fff3cd; -fx-border-color: #e6a817;
                      -fx-border-width: 1; -fx-padding: 5 10 5 10; -fx-font-size: 11;
                      -fx-background-radius: 6; -fx-border-radius: 6;"/>
    </HBox>

    <!-- Contenido principal -->
    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

        <!-- Panel izquierdo: formulario -->
        <VBox spacing="9" minWidth="320" prefWidth="340"
              style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">

            <Label text="Datos del visitante"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;
                          -fx-border-color: #0071e3; -fx-border-width: 0 0 0 3;
                          -fx-padding: 0 0 0 8;"/>
            <Label text="(el saldo lo recarga un operador)"
                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>

            <GridPane hgap="9" vgap="8">
                <Label text="Nombre:"     GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <TextField fx:id="txtNombre"    GridPane.rowIndex="0" GridPane.columnIndex="1"
                           promptText="Nombre completo"/>
                <Label text="Documento:"  GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <TextField fx:id="txtDocumento" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           promptText="Numero de doc."/>
                <Label text="Edad:"       GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <TextField fx:id="txtEdad"      GridPane.rowIndex="2" GridPane.columnIndex="1"
                           promptText="Años"/>
                <Label text="Telefono:"   GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <TextField fx:id="txtTelefono"  GridPane.rowIndex="3" GridPane.columnIndex="1"
                           promptText="3001234567"/>
                <Label text="Direccion:"  GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <TextField fx:id="txtDireccion" GridPane.rowIndex="4" GridPane.columnIndex="1"
                           promptText="Calle / Carrera"/>
                <Label text="Estatura:"   GridPane.rowIndex="5" GridPane.columnIndex="0"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                <TextField fx:id="txtEstatura"  GridPane.rowIndex="5" GridPane.columnIndex="1"
                           promptText="ej: 1.75"/>
            </GridPane>

            <HBox spacing="8" style="-fx-padding: 4 0 0 0;">
                <Button text="Guardar" onAction="#onGuardar"
                        style="-fx-background-color: #0071e3; -fx-text-fill: white;
                               -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button text="Actualizar" onAction="#onActualizar"
                        style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151;
                               -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button text="Eliminar" onAction="#onEliminar"
                        style="-fx-background-color: #ff3b30; -fx-text-fill: white;
                               -fx-background-radius: 7; -fx-cursor: hand;"/>
            </HBox>

            <Label fx:id="lblMensaje" text="" wrapText="true"
                   style="-fx-text-fill: #374151; -fx-font-size: 11px;"/>

        </VBox>

        <!-- Panel derecho: tabla + secciones -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">

            <!-- Tabla -->
            <VBox spacing="6" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                <Label text="Visitantes registrados"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <TableView fx:id="tablaVisitantes" VBox.vgrow="ALWAYS" prefHeight="280">
                    <columns>
                        <TableColumn fx:id="colNombre"    text="Nombre"    prefWidth="110"/>
                        <TableColumn fx:id="colDocumento" text="Documento" prefWidth="95"/>
                        <TableColumn fx:id="colEdad"      text="Edad"      prefWidth="50"/>
                        <TableColumn fx:id="colTelefono"  text="Telefono"  prefWidth="100"/>
                        <TableColumn fx:id="colDireccion" text="Direccion" prefWidth="120"/>
                        <TableColumn fx:id="colEstatura"  text="Estatura"  prefWidth="70"/>
                        <TableColumn fx:id="colSaldo"     text="Saldo"     prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Comprar ticket -->
            <VBox spacing="8"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                <Label text="Comprar ticket"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;
                              -fx-border-color: #0071e3; -fx-border-width: 0 0 0 3;
                              -fx-padding: 0 0 0 8;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Tipo:" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                    <ComboBox fx:id="cbTipoTicket" prefWidth="130" onAction="#onCambiarTipoTicket"/>
                    <Label text="Precio:" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                    <Label fx:id="lblPrecioTicket" text="---"
                           style="-fx-font-weight: bold; -fx-text-fill: #0071e3; -fx-min-width: 80;"/>
                    <Label fx:id="lblNumIntegrantes" text="Integrantes:"
                           visible="false" managed="false"
                           style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                    <TextField fx:id="txtNumIntegrantes" prefWidth="80"
                               promptText="ej: 4" visible="false" managed="false"/>
                    <Button text="Comprar" onAction="#onComprarTicket"
                            style="-fx-background-color: #0071e3; -fx-text-fill: white;
                                   -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="lblDescuentoInfo" text=""
                       style="-fx-text-fill: #16a34a; -fx-font-size: 11px;"/>
                <Label fx:id="lblTicketMsg" text=""
                       style="-fx-font-size: 11px; -fx-text-fill: #374151;"/>
            </VBox>

            <!-- Favoritas -->
            <VBox spacing="7"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                <Label text="Atracciones favoritas"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;
                              -fx-border-color: #ff3b30; -fx-border-width: 0 0 0 3;
                              -fx-padding: 0 0 0 8;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cbAtraccionFav" prefWidth="210"/>
                    <Button text="Agregar favorita" onAction="#onAgregarFavorita"
                            style="-fx-background-color: #ff3b30; -fx-text-fill: white;
                                   -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="lblFavoritas" text="Sin favoritas" wrapText="true"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Notificaciones -->
            <VBox spacing="7"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                <Label text="Notificaciones"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;
                              -fx-border-color: #ff9f0a; -fx-border-width: 0 0 0 3;
                              -fx-padding: 0 0 0 8;"/>
                <TextArea fx:id="txtNotificaciones" editable="false" wrapText="true"
                          prefHeight="75"
                          promptText="Selecciona un visitante para ver sus notificaciones"
                          style="-fx-font-size: 11px; -fx-background-color: #f9fafb;"/>
            </VBox>

        </VBox>
    </HBox>

</VBox>

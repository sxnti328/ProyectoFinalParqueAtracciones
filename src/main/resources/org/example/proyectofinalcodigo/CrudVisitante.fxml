<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" prefWidth="950" prefHeight="700"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalcodigo.viewController.VisitanteViewController"
      style="-fx-background-color: #f5f5f7;">

    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

    <!-- header -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="&lt; Volver" onAction="#onVolver"/>
        <Label text="Gestion de Visitantes"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblNotificacion" text=""
               visible="false" managed="false"
               wrapText="true" maxWidth="280"
               style="-fx-background-color: #fff3cd; -fx-border-color: #e6a817;
                      -fx-border-width: 1; -fx-padding: 5 10 5 10; -fx-font-size: 11;"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- formulario -->
        <VBox spacing="8" minWidth="320" prefWidth="340"
              style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 10;">

            <Label text="Datos del visitante"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
            <Label text="(el saldo lo recarga un operador)"
                   style="-fx-font-size: 11px; -fx-text-fill: #999;"/>

            <GridPane hgap="8" vgap="7">
                <Label text="Nombre:"     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre"    GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Documento:"  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDocumento" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Edad:"       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEdad"      GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Telefono:"   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefono"  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Direccion:"  GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDireccion" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Estatura:"   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEstatura"  GridPane.rowIndex="5" GridPane.columnIndex="1"
                           promptText="ej: 1.75"/>
            </GridPane>

            <HBox spacing="8" style="-fx-padding: 4 0 0 0;">
                <Button text="Guardar"    onAction="#onGuardar"
                        style="-fx-background-color: #0071e3; -fx-text-fill: white; -fx-background-radius: 7;"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
                <Button text="Eliminar"   onAction="#onEliminar"
                        style="-fx-background-color: #ff3b30; -fx-text-fill: white; -fx-background-radius: 7;"/>
            </HBox>

            <Label fx:id="lblMensaje" text="" wrapText="true"
                   style="-fx-text-fill: #555; -fx-font-size: 11px;"/>

        </VBox>

        <!-- tabla + ticket -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">

            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10;"
                  VBox.vgrow="ALWAYS">
                <Label text="Visitantes registrados"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <TableView fx:id="tablaVisitantes" VBox.vgrow="ALWAYS" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colNombre"    text="Nombre"    prefWidth="110"/>
                        <TableColumn fx:id="colDocumento" text="Documento" prefWidth="95"/>
                        <TableColumn fx:id="colEdad"      text="Edad"      prefWidth="50"/>
                        <TableColumn fx:id="colTelefono"  text="Telefono"  prefWidth="100"/>
                        <TableColumn fx:id="colDireccion" text="Direccion" prefWidth="120"/>
                        <TableColumn fx:id="colEstatura"  text="Estatura"  prefWidth="70"/>
                        <TableColumn fx:id="colSaldo"     text="Saldo"     prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="8"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10;">
                <Label text="Comprar ticket"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Tipo:"/>
                    <ComboBox fx:id="cbTipoTicket" prefWidth="130" onAction="#onCambiarTipoTicket"/>
                    <Label text="Precio:"/>
                    <Label fx:id="lblPrecioTicket" text="---"
                           style="-fx-font-weight: bold; -fx-text-fill: #0071e3; -fx-min-width: 80;"/>
                    <Label fx:id="lblNumIntegrantes" text="Integrantes:"
                           visible="false" managed="false"/>
                    <TextField fx:id="txtNumIntegrantes" prefWidth="80"
                               promptText="ej: 4" visible="false" managed="false"/>
                    <Button text="Comprar" onAction="#onComprarTicket"
                            style="-fx-background-color: #0071e3; -fx-text-fill: white; -fx-background-radius: 7;"/>
                </HBox>
                <Label fx:id="lblDescuentoInfo" text="" style="-fx-text-fill: #2a7a2a; -fx-font-size: 11px;"/>
                <Label fx:id="lblTicketMsg"     text="" style="-fx-font-size: 11px;"/>
            </VBox>

        </VBox>
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="0" prefWidth="950" prefHeight="700"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalcodigo.viewController.MainViewController"
      style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #1a1a2e, #16213e, #0f3460);">

    <VBox alignment="CENTER" spacing="8" maxWidth="400">

        <StackPane prefWidth="76" prefHeight="76"
                   style="-fx-background-color: #0071e3; -fx-background-radius: 18;">
            <Label text="P"
                   style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </StackPane>

        <Label text="Tech-Park UQ"
               style="-fx-font-size: 34px; -fx-font-weight: bold;
                      -fx-text-fill: white; -fx-padding: 6 0 0 0;"/>

        <Label text="Sistema de Gestion del Parque"
               style="-fx-font-size: 13px; -fx-text-fill: #8892a4;"/>

        <VBox spacing="12" maxWidth="300" style="-fx-padding: 32 0 0 0;">

            <Button text="Gestion de Visitantes"
                    onAction="#irAVisitantes"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 12; -fx-cursor: hand;"/>

            <Button text="Panel de Operador"
                    onAction="#irAOperador"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: #5856d6; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 12; -fx-cursor: hand;"/>

            <Button text="Administracion"
                    onAction="#irAAdmin"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: #ff9f0a; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 12; -fx-cursor: hand;"/>

        </VBox>

        <Label text="Programacion I  —  2026"
               style="-fx-font-size: 11px; -fx-text-fill: #3d4a5c; -fx-padding: 30 0 0 0;"/>

    </VBox>

</VBox>

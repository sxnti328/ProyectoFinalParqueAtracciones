<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="0" prefWidth="950" prefHeight="700"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalcodigo.viewController.MainViewController"
      style="-fx-background-color: #f5f5f7;">

    <VBox alignment="CENTER" spacing="18" maxWidth="400">

        <Label text="Parque de Atracciones"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1d1d1f;"/>

        <Label text="Tech-Park UQ — Sistema de gestion"
               style="-fx-font-size: 14px; -fx-text-fill: #6e6e73;"/>

        <VBox spacing="10" maxWidth="280" style="-fx-padding: 20 0 0 0;">

            <Button text="Gestion de Visitantes"
                    onAction="#irAVisitantes"
                    maxWidth="Infinity" prefHeight="42"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-background-radius: 10;
                           -fx-cursor: hand;"/>

            <Button text="Panel de Operador"
                    onAction="#irAOperador"
                    maxWidth="Infinity" prefHeight="42"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-background-radius: 10;
                           -fx-cursor: hand;"/>

            <Button text="Administracion"
                    onAction="#irAAdmin"
                    maxWidth="Infinity" prefHeight="42"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-background-radius: 10;
                           -fx-cursor: hand;"/>

        </VBox>

        <Label text="Programacion I — 2026"
               style="-fx-font-size: 11px; -fx-text-fill: #aeaeb2; -fx-padding: 24 0 0 0;"/>

    </VBox>

</VBox>

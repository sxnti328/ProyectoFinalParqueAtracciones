<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" prefWidth="850" prefHeight="680"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalcodigo.viewController.OperadorViewController"
      style="-fx-background-color: #f5f5f7;">

    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="&lt; Volver" onAction="#onVolver"/>
        <Label text="Panel Operador"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- seleccion de operador -->
    <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Operador:"/>
            <ComboBox fx:id="cbOperador" prefWidth="220" onAction="#onSeleccionarOperador"/>
            <Label fx:id="lblInfoOperador" style="-fx-text-fill: #555;"/>
        </HBox>
        <Label fx:id="lblZona" style="-fx-text-fill: #777; -fx-font-size: 11px;"/>
    </VBox>

    <!-- tabla de atracciones -->
    <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
        <Label text="Atracciones de la zona:"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TableView fx:id="tablaAtracciones" prefHeight="140">
            <columns>
                <TableColumn fx:id="colNombreA"     text="Nombre"     prefWidth="150"/>
                <TableColumn fx:id="colTipoA"       text="Tipo"       prefWidth="120"/>
                <TableColumn fx:id="colEstadoA"     text="Estado"     prefWidth="120"/>
                <TableColumn fx:id="colVisitantesA" text="Visitantes" prefWidth="90"/>
                <TableColumn fx:id="colEsperaA"     text="Espera"     prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <!-- acciones -->
    <HBox spacing="10">

        <VBox spacing="6" prefWidth="260"
              style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
            <Label text="Validar acceso"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <Label text="Documento visitante:"/>
            <TextField fx:id="txtDocVisitante"/>
            <Label text="Atraccion:"/>
            <ComboBox fx:id="cbAtraccionAcceso" prefWidth="240"/>
            <Button text="Validar" onAction="#onValidarAcceso"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white; -fx-background-radius: 6;"/>
            <Label fx:id="lblResultadoAcceso" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
        </VBox>

        <VBox spacing="6" prefWidth="260"
              style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
            <Label text="Cambiar estado"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <Label text="Atraccion:"/>
            <ComboBox fx:id="cbAtraccionEstado" prefWidth="240"/>
            <Label text="Nuevo estado:"/>
            <ComboBox fx:id="cbNuevoEstado" prefWidth="240"/>
            <Label text="Motivo:"/>
            <ComboBox fx:id="cbMotivo" prefWidth="240"/>
            <Button text="Cambiar" onAction="#onCambiarEstado"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white; -fx-background-radius: 6;"/>
            <Label fx:id="lblResultadoEstado" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
        </VBox>

        <VBox spacing="6" prefWidth="260"
              style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
            <Label text="Revision tecnica"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <Label text="Atraccion:"/>
            <ComboBox fx:id="cbAtraccionRevision" prefWidth="240"/>
            <Label text="Descripcion:"/>
            <TextArea fx:id="txtDescripcion" prefHeight="60" prefWidth="240" wrapText="true"/>
            <Button text="Registrar" onAction="#onRegistrarRevision"
                    style="-fx-background-color: #0071e3; -fx-text-fill: white; -fx-background-radius: 6;"/>
            <Label fx:id="lblResultadoRevision" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
        </VBox>

    </HBox>

    <!-- recarga de saldo -->
    <VBox spacing="6" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
        <Label text="Recargar saldo de un visitante:"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Documento:"/>
            <TextField fx:id="txtDocSaldo" prefWidth="130"/>
            <Label text="Monto:"/>
            <TextField fx:id="txtMontoSaldo" prefWidth="120"/>
            <Button text="Recargar" onAction="#onRecargarSaldo"
                    style="-fx-background-color: #34c759; -fx-text-fill: white; -fx-background-radius: 6;"/>
        </HBox>
        <Label fx:id="lblResultadoSaldo" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
    </VBox>

</VBox>
